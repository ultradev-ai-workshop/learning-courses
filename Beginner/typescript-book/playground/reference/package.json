{
  "name": "library-loans",
  "version": "1.0.0",
  "private": true,
  "description": "Capstone of the TypeScript Study Book: a small library-loans system in strict TypeScript.",
  "type": "module",
  "exports": { ".": { "types": "./dist/src/index.d.ts", "default": "./dist/src/index.js" } },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsc",
    "start": "tsc && node --enable-source-maps dist/src/cli.js",
    "test": "tsc && node --test \"dist/test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "7.0.2"
  }
}
